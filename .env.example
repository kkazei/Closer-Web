# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration and database connections
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Server-only session signing secret (generate at least 32 random characters)
JWT_SECRET=

# Development-only seed controls; do not use these for production data
CLOSER_SEED_MODE=development
CLOSER_SEED_USER_ID=

# Server-only chat generation configuration
GROQ_API_KEY=
# RAG embeddings run locally; Transformers.js downloads the model on first use.
